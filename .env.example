# OutFox Cloud Vault Environment Configuration

# Server Port (Render & Railway inject this automatically)
PORT=4000

# Master Admin Key to unlock the private Web Dashboard (leave empty for open dev mode)
ADMIN_API_KEY=outfox_vault_master_secret_2026

# Client API Key required by external extensions and apps (leave empty for open public access)
CLIENT_API_KEY=outfox_client_key_2026
