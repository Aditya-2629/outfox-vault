# OutFox Cloud Vault Environment Configuration
PORT=4000

# Master Admin Key to unlock the private Web Dashboard and /admin/vault/*
ADMIN_API_KEY=007_haiSecret

# Client API Key required by external extensions and apps (x-api-key)
CLIENT_API_KEY=007_haiSecret

# Developer Telegram Bot Alerts (Optional - sends 12-hour deduplicated capture guides on 400/404/410)
DEV_TELEGRAM_BOT_TOKEN=
DEV_TELEGRAM_CHAT_ID=
